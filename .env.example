# Telegram Bot Token (получите у @BotFather)
BOT_TOKEN=your_bot_token_here

# Ваш Telegram User ID (получите через @userinfobot)
BOT_ADMIN_ID=123456789

# Bridge API Configuration
BRIDGE_API_URL=https://api.bridge-ai.com/v1/chat/completions
BRIDGE_API_KEY=your_bridge_api_key_here
BRIDGE_MODEL=gpt-4o

# Database path (optional, default: expenses.db)
DB_PATH=expenses.db
